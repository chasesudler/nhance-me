# Nhance Me environment variables.
# Copy this file to .env.local for local development, or set the same names
# in the Vercel dashboard for production. Never commit real values.

# --- Server secrets ---
# Vercel Blob read/write token, used to host images sent to the AI models.
BLOB_READ_WRITE_TOKEN=
# Replicate API token for the enhance and staging models.
REPLICATE_API_TOKEN=
# Optional model overrides (defaults are set in the API routes).
REPLICATE_ENHANCE_MODEL=
REPLICATE_STAGE_MODEL=
# Signs the app session cookie. Set a long random value in production,
# otherwise sessions are signed with an ephemeral key and reset on restart.
NHANCE_API_SECRET=

# --- Client config ---
# Base URL for API calls from the Capacitor mobile build. Leave empty for
# the web app (same origin); the mobile build points this at the deployed
# web URL, e.g. https://www.nhanceme.today
NEXT_PUBLIC_API_BASE=

# --- Firebase Auth (client config; these values are not secret, but they
# must match the Firebase project for this app) ---
# Firebase console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
